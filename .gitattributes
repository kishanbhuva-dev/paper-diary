# Auto detect text files and perform LF normalization
* text=auto

# Force LF for all shell scripts and hooks (critical for cross-platform)
*.sh text eol=lf
.husky/* text eol=lf

# Force LF for JavaScript (consistency)
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.vue text eol=lf
*.json text eol=lf

# Force LF for PHP
*.php text eol=lf

# Force LF for config files
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.blade.php text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
