# ═══════════════════════════════════════════════════════════════
# ENVIRONMENT & CONFIG
# ═══════════════════════════════════════════════════════════════
.env
.env.backup
.env.production
.env.*.local
/auth.json

# ═══════════════════════════════════════════════════════════════
# LOGS
# ═══════════════════════════════════════════════════════════════
*.log
/storage/logs/*
!/storage/logs/.gitignore
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ═══════════════════════════════════════════════════════════════
# CACHE FILES
# ═══════════════════════════════════════════════════════════════

# PHPStan cache
.phpstan/
.phpstan/cache/

# PHPUnit cache
.phpunit.cache/
.phpunit.result.cache

# Composer cache
composer.lock.backup
composer.phar

# NPM / Node cache
.npm/
.yarn/
.pnp/
.pnp.js
node_modules/.cache/

# Vite cache
.vite/
dist/

# Laravel cache
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Storage keys
/storage/*.key
/storage/pail
/storage/api-docs/*

# Public storage
/public/build
/public/hot
/public/storage

# ═══════════════════════════════════════════════════════════════
# DEPENDENCIES
# ═══════════════════════════════════════════════════════════════
/vendor
/node_modules

# ═══════════════════════════════════════════════════════════════
# IDE FILES
# ═══════════════════════════════════════════════════════════════
.idea/
.vscode/
*.iml
*.ipr
*.iws
.fleet/
.nova/
.zed/
.phpactor.json
.phpstorm.meta.php

# IDE Helper generated files
_ide_helper.php
_ide_helper_models.php

# ═══════════════════════════════════════════════════════════════
# OS FILES
# ═══════════════════════════════════════════════════════════════
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

# ═══════════════════════════════════════════════════════════════
# TEMPORARY FILES
# ═══════════════════════════════════════════════════════════════
*.tmp
*.temp
*.cache
.cache/
tmp/
temp/

