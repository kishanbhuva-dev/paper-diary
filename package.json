{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "lint:strict": "eslint . --max-warnings 0 --no-fix",
    "format": "prettier --write \"resources/**/*.{js,vue,json,css,md}\"",
    "format:check": "prettier --check \"resources/**/*.{js,vue,json,css,md}\"",
    "type-check": "vue-tsc --noEmit",
    "prepare": "husky",
    "postinstall": "husky || true",
    "pre-commit": "lint-staged",
    "commit": "cz",
    "quality": "npm run lint:strict && npm run format:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "axios": "^1.11.0",
    "commitizen": "^4.3.0",
    "concurrently": "^9.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "laravel-vite-plugin": "^2.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.7"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@stripe/stripe-js": "^8.6.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.1",
    "sweetalert2": "^11.26.3",
    "vue": "^3.5.22",
    "vue-hotel-booking-calendar": "^1.0.14",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9",
    "vue3-apexcharts": "^1.10.0",
    "xlsx": "^0.18.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
